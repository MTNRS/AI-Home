AI_HOME_ENVIRONMENT=development
AI_HOME_DATABASE_URL=postgresql+psycopg://ai_home:change-this-local-password@localhost:5432/ai_home
AI_HOME_SESSION_LIFETIME_SECONDS=86400
AI_HOME_POSTGRES_PASSWORD=change-this-local-password
# Supabase Auth project settings. Keep the secret key on the server only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Derived automatically from SUPABASE_URL if omitted.
# SUPABASE_JWKS_URL=
# Optional authenticated chat proxy to an OpenAI-compatible provider.
# Foundation is the default backend. External providers require explicit selection.
# AI_HOME_CHAT_BACKEND=foundation
# AI_HOME_FOUNDATION_CHECKPOINT=artifacts/foundation-smoke-cpu/foundation-nano.pt
# AI_HOME_FOUNDATION_DEVICE=auto
# AI_HOME_FOUNDATION_MAX_NEW_TOKENS=128
# AI_HOME_FOUNDATION_MEMORY_BUDGET_BYTES=2000000000
# Experimental CPU gradient tasks require operator activation and worker opt-in.
# AI_HOME_FOUNDATION_DISTRIBUTED_TRAINING_ENABLED=false
# Adapter jobs require separate operator activation and worker opt-in.
# AI_HOME_FOUNDATION_DISTRIBUTED_ADAPTERS_ENABLED=false
# Set AI_HOME_CHAT_BACKEND=openai-compatible to use the external proxy below.
# AI_HOME_CHAT_PROVIDER_URL=
# AI_HOME_CHAT_PROVIDER_MODEL=
# AI_HOME_CHAT_PROVIDER_API_KEY=
# AI_HOME_CHAT_PROVIDER_TIMEOUT_SECONDS=180
# Keep the 32+ character review token in a secret manager in deployed environments.
# AI_HOME_TRAINING_REVIEW_TOKEN=
# AI_HOME_TRAINING_REVIEWER_ID=reviewer-name

